# Copy to .env and replace every CHANGE_ME value. Keep .env private.
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20

# Hoymiles / Array 1. Uses the S-Miles Home cloud-login flow implemented from
# https://github.com/Eistee82/ioBroker.hoymiles (unofficial; may change upstream).
HOYMILES_ENABLED=true
HOYMILES_AUTH_MODE=smiles_cloud
HOYMILES_USERNAME=CHANGE_ME@example.com
HOYMILES_PASSWORD=CHANGE_ME
# Leave blank to select the first plant on the account. Set this to lock to one plant.
HOYMILES_STATION_ID=
HOYMILES_APP_VERSION=2.9.0
HOYMILES_ENERGY_VALUE_TYPE=cumulative

# Myenergi / Array 2. Set the auth method required by your account.
# auth mode can be: none, bearer, api_key, basic, digest, oauth_client_credentials.
MYENERGI_ENABLED=true
MYENERGI_STATUS_URL=https://CHANGE_ME.example/cgi-jstatus-E
MYENERGI_AUTH_MODE=digest
MYENERGI_API_KEY=
MYENERGI_API_KEY_HEADER=X-API-Key
MYENERGI_USERNAME=
MYENERGI_PASSWORD=
MYENERGI_HEADERS_JSON={}
MYENERGI_POWER_PATH=data.generation_w
MYENERGI_ENERGY_PATH=data.energy_wh_total
MYENERGI_ENERGY_VALUE_TYPE=cumulative
MYENERGI_POWER_MULTIPLIER=1
MYENERGI_ENERGY_MULTIPLIER=1

# Grafana is the only LAN-exposed service. Change if 3000 is already in use.
GRAFANA_PORT=3000
