# Copy to .env and replace every CHANGE_ME value. Keep .env private.
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20

# Hoymiles / Array 1. Uses the S-Miles Home cloud-login flow implemented from
# https://github.com/Eistee82/ioBroker.hoymiles (unofficial; may change upstream).
HOYMILES_ENABLED=true
HOYMILES_AUTH_MODE=smiles_cloud
HOYMILES_USERNAME=CHANGE_ME@example.com
HOYMILES_PASSWORD=CHANGE_ME
# Leave blank to select the first plant on the account. Set this to lock to one plant.
HOYMILES_STATION_ID=
HOYMILES_APP_VERSION=2.9.0
HOYMILES_ENERGY_VALUE_TYPE=cumulative

# Myenergi / Array 2. Set the auth method required by your account.
# auth mode can be: none, bearer, api_key, basic, digest, oauth_client_credentials.
MYENERGI_ENABLED=true
MYENERGI_STATUS_URL=https://CHANGE_ME.example/cgi-jstatus-E
MYENERGI_AUTH_MODE=digest
MYENERGI_API_KEY=
MYENERGI_API_KEY_HEADER=X-API-Key
MYENERGI_USERNAME=
MYENERGI_PASSWORD=
MYENERGI_HEADERS_JSON={}
MYENERGI_POWER_PATH=data.generation_w
MYENERGI_ENERGY_PATH=data.energy_wh_total
MYENERGI_ENERGY_VALUE_TYPE=cumulative
MYENERGI_POWER_MULTIPLIER=1
MYENERGI_ENERGY_MULTIPLIER=1
# Eddi hot-water temperature (degrees C). Leave blank to disable this metric.
MYENERGI_HOT_WATER_TEMPERATURE_PATH=eddi.0.tp1
# Eddi and Zappi status URLs use the same Myenergi server. When omitted, either
# URL is derived automatically from MYENERGI_STATUS_URL when possible.
MYENERGI_EDDI_STATUS_URL=https://s18.myenergi.net/cgi-jstatus-E
MYENERGI_ZAPPI_STATUS_URL=https://s18.myenergi.net/cgi-jstatus-Z
MYENERGI_ZAPPI_GRID_POWER_PATH=zappi.0.grd
MYENERGI_ZAPPI_GENERATION_POWER_PATH=zappi.0.gen

# Grafana is the only LAN-exposed service. Change if 3000 is already in use.
GRAFANA_PORT=3000

# Full-screen rotating dashboard display, served at port 8080 by default.
KIOSK_PORT=8080
KIOSK_INTERVAL_SECONDS=30
# Optional JSON array of pages. {{HOST}} becomes the Pi's hostname/IP in the browser.
# Leave as [] to show the NRGMon Grafana dashboard (the default first page).
# KIOSK_PAGES=["http://{{HOST}}:3000/d/solar-generation/solar-generation?orgId=1&kiosk"]
KIOSK_PAGES=[]

# Optional Solarman house battery monitoring. Password is hashed by the adapter.
SOLARMAN_ENABLED=false
SOLARMAN_BASE_URL=https://globalapi.solarmanpv.com
SOLARMAN_APP_ID=
SOLARMAN_APP_SECRET=
SOLARMAN_EMAIL=
SOLARMAN_PASSWORD=
# Blank selects the station only if the account has exactly one.
SOLARMAN_STATION_ID=
# Merchant accounts only; leave blank for a home account.
SOLARMAN_ORG_ID=
# Optional usable capacity; SOC * capacity gives estimated stored kWh.
SOLARMAN_BATTERY_CAPACITY_KWH=
# Reject cloud readings older than this, even if the API call succeeds.
SOLARMAN_MAX_AGE_SECONDS=900
# Station power values are treated as W. Set 1000 only if your account returns kW.
SOLARMAN_POWER_MULTIPLIER=1
# Keep true if Myenergi generation measures net solar/battery inverter output.
# Set false only if the generation CT measures solar alone.
MYENERGI_GENERATION_INCLUDES_BATTERY=true
