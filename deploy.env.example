# Copy to deploy.env, set the values, and keep deploy.env private.
# The deployment script copies the application settings below to the Pi as .env.

# SSH deployment target. DEPLOY_PATH must be an absolute path on the Pi.
DEPLOY_HOST=CHANGE_ME
DEPLOY_USER=pi
DEPLOY_PORT=22
# Optional. Leave blank to use your SSH agent/key or be prompted interactively.
DEPLOY_PASSWORD=
DEPLOY_PATH=/home/pi/nrgmon

# Collector settings
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=20

# Hoymiles / Lounge Roof
HOYMILES_ENABLED=true
HOYMILES_AUTH_MODE=smiles_cloud
HOYMILES_USERNAME=CHANGE_ME@example.com
HOYMILES_PASSWORD=CHANGE_ME
HOYMILES_STATION_ID=
HOYMILES_APP_VERSION=2.9.0
HOYMILES_ENERGY_VALUE_TYPE=cumulative

# Myenergi / House Roof. Digest authentication uses the Myenergi hub serial
# as MYENERGI_USERNAME and the app/API password as MYENERGI_PASSWORD.
# Leave MYENERGI_API_KEY blank when it is not required.
MYENERGI_ENABLED=true
MYENERGI_STATUS_URL=https://CHANGE_ME.example/cgi-jstatus-E
MYENERGI_AUTH_MODE=digest
MYENERGI_API_KEY=
MYENERGI_API_KEY_HEADER=X-API-Key
MYENERGI_USERNAME=
MYENERGI_PASSWORD=
MYENERGI_HEADERS_JSON={}
MYENERGI_POWER_PATH=data.generation_w
MYENERGI_ENERGY_PATH=data.energy_wh_total
MYENERGI_ENERGY_VALUE_TYPE=cumulative
MYENERGI_POWER_MULTIPLIER=1
MYENERGI_ENERGY_MULTIPLIER=1

# Grafana is the only LAN-exposed service.
GRAFANA_PORT=3000
